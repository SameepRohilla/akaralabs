    "db:seed": "tsx src/db/seed.ts",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "bcryptjs": "3.0.2",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "marked": "15.0.12",
    "nanoid": "5.1.16",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "postgres": "3.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sanitize-html": "2.17.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/sanitize-html": "2.16.0",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "^16.14.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4",
    "esbuild": "0.28.2"
