# Copy to .env on the server (docker compose reads it) or .env.local for dev.
# Everything marked REQUIRED must be set before the app will start.

# ── REQUIRED ──────────────────────────────────────────────────────────────
# Postgres. In compose this is the internal hostname, not localhost.
# Must match POSTGRES_PASSWORD exactly. Use hex, not base64 — a "/" in the
# password breaks URL parsing and the driver only says "Invalid URL".
#   openssl rand -hex 24
DATABASE_URL=postgres://akara:CHANGE_ME@db:5432/akara
POSTGRES_PASSWORD=CHANGE_ME

# Signs session cookies. Generate with:  openssl rand -base64 33
# Changing it signs everybody out.
AUTH_SECRET=CHANGE_ME

# Canonical URL. Baked into the client bundle at build time as well as read
# at runtime, so set it before building the image.
SITE_URL=https://akaralabs.in
NEXT_PUBLIC_SITE_URL=https://akaralabs.in
NEXTAUTH_URL=https://akaralabs.in

# Caddy uses these for the certificate.
SITE_DOMAIN=akaralabs.in
ACME_EMAIL=hello@akaralabs.in

# Which image to run. The deploy workflow rewrites this line to an immutable
# sha- tag on every release, and reads it back to know what to roll back to.
#
# Use :latest ONLY for the very first manual deploy, then let CI replace it.
# Production should always be pinned to a specific sha- tag: :latest is
# mutable, so "which code is actually running" stops being answerable, and a
# rollback has nothing definite to go back to.
# Registry names must be lowercase, including your username.
IMAGE=ghcr.io/your-github-username/akaralabs:latest

# ── Google sign-in ────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorised redirect URI must be exactly:
#   https://akaralabs.in/api/auth/callback/google
# Leave blank and the Google button simply won't work; email/password still will.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. These addresses are made admin automatically on first
# sign-in — put your own address here before the first deploy.
ADMIN_EMAILS=sameep@akaralabs.in

# ── Email ─────────────────────────────────────────────────────────────────
# Any SMTP provider: Zoho, Google Workspace, Amazon SES, Resend's SMTP bridge.
#
# LEAVE THIS BLOCK COMMENTED OUT until you have a real password. With SMTP_HOST
# unset, mail is logged instead of sent, which is what you want locally.
#
# Setting SMTP_HOST with an empty SMTP_PASS does NOT fall back to logging — it
# tries to authenticate, fails with `Missing credentials for "PLAIN"`, and every
# email silently doesn't arrive. Half-configured is worse than not configured.
#
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=587
# SMTP_USER=hello@akaralabs.in
# SMTP_PASS=your-app-specific-password
# SMTP_FROM=Akara Labs <hello@akaralabs.in>

# Where new enquiries and customer replies land.
STUDIO_INBOX=hello@akaralabs.in

# ── Site details shown in the footer and emails ───────────────────────────
CONTACT_EMAIL=hello@akaralabs.in
CONTACT_WHATSAPP=917082089049
GST_NUMBER=
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=

# ── Optional ──────────────────────────────────────────────────────────────
# Shared secret for the daily housekeeping endpoint. Generate with:
#   openssl rand -hex 24
# Then on the server:  0 6 * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://akaralabs.in/api/cron
CRON_SECRET=

# Upload ceiling per file, in bytes. Default 95 MB.
#
# Why not more: with the domain proxied through Cloudflare (orange cloud),
# Cloudflare itself rejects bodies over 100 MB on Free and Pro — before the
# request reaches your server — so a higher number here just produces an
# opaque Cloudflare 413 instead of a clear message from the app.
#   Free / Pro   100 MB
#   Business     200 MB
#   Enterprise   up to 5 GB
# DNS-only (grey cloud) has no such limit, but you lose the CDN and WAF.
# If you raise this, raise Caddy's request_body max_size to match.
MAX_UPLOAD_BYTES=99614720

# Where uploaded files live inside the container (a docker volume).
STORAGE_DIR=/data/storage

# Set to 1 to log every SQL statement. Noisy; for debugging only.
DB_LOG=0
